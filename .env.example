# Neon Postgres (filled in automatically when Neon is connected in Vercel → Storage)
DATABASE_URL=

# Vercel Blob (filled in automatically when a Blob store is connected)
BLOB_READ_WRITE_TOKEN=

# Optional: public site URL used for share links, QR codes and payment return URLs
NEXT_PUBLIC_SITE_URL=

# Local development without Neon/Blob: LOCAL_DEV=1 (data in .local-data)
LOCAL_DEV=

# Midtrans (QRIS + GoPay). The paywall is on only when both keys are set.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# "true" for real payments; anything else uses the Sandbox
MIDTRANS_IS_PRODUCTION=false

# Optional roll prices in Rupiah (minimum 1000), e.g.
# ROLL_PRICES=mini:9000,classic:19000,pro:25000,party:49000,fiesta:99000,gala:179000
ROLL_PRICES=

# Protects the daily cleanup job (/api/cron/cleanup)
CRON_SECRET=
